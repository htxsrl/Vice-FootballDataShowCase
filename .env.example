# Copia questo file in .env (gitignored) e inserisci i valori reali.
# Mai committare .env: la chiave resta solo lì.

# Gateway Hydrogen di HTX (LiteLLM, API compatibile OpenAI)
VICE_LLM_BASE_URL=https://hydrogen.ht-x.com
VICE_LLM_API_KEY=

# Modelli per compito (vedi wiki/tecnica/modelli-llm.md)
VICE_MODEL_AGENT=HTX-EU-Claude-Sonnet-5
VICE_MODEL_DEEP=HTX-EU-Claude-Opus-5.5
# Riserva se il modello scelto non risponde dopo i nuovi tentativi (decisione 34)
VICE_MODEL_RISERVA=HTX-EU-Claude-Sonnet-4.6

# Cartella dei dati (facoltativa): di default data/ nella radice del progetto (/app/data nel container)
# VICE_DATA_DIR=

# Il giorno della demo, l'"oggi" simulato (facoltativa, AAAA-MM-GG; decisione 54): la sua seduta si carica col file
# VICE_OGGI=2024-04-19
